# ==============================================================================
# FPT Polytechnic Virtual Campus 360° — Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Next.js Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend API Configuration
API_PORT=4000

# Database Configuration (PostgreSQL)
POSTGRES_USER=fpt_admin
POSTGRES_PASSWORD=fpt_poly_secret_2026
POSTGRES_DB=virtual_campus_360
POSTGRES_PORT=5432
DATABASE_URL="postgresql://fpt_admin:fpt_poly_secret_2026@localhost:5432/virtual_campus_360?schema=public"

# Authentication (JWT)
JWT_SECRET=fpt_virtual_campus_jwt_secret_key_super_secure_2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=fpt_virtual_campus_refresh_secret_key_2026
JWT_REFRESH_EXPIRATION=7d

# Media Storage (Cloudflare R2 / S3)
STORAGE_TYPE=s3
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=fpt-virtual-campus-media
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_PUBLIC_DOMAIN=https://media.virtualcampus.polytechnic.edu.vn
