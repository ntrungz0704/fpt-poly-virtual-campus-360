# ==============================================================================
# FPT Polytechnic Virtual Campus 360° — Environment Variables Template (Phase 2A)
# Copy to .env for local development. Never commit real credentials to Git.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
DATA_SOURCE=mock

# Web & CORS Origins
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000

# Backend API Configuration (Phase 2A-2+)
API_PORT=4000
RATE_LIMIT_STORE=memory

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=fpt_admin
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=virtual_campus_360
POSTGRES_PORT=5432
DATABASE_URL="postgresql://fpt_admin:CHANGE_ME_LOCAL_POSTGRES_PASSWORD@localhost:5432/virtual_campus_360?schema=public"

# Bootstrap Admin Secret (Required for prisma seed; minimum 12 characters)
# NEVER reuse leaked/default passwords or commit actual values.
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_MIN_12

# Authentication (JWT — Phase 2A-2+)
JWT_SECRET=CHANGE_ME_RANDOM_HEX_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_HEX_SECRET_32_CHARS
JWT_REFRESH_EXPIRATION=7d

# Media Storage (Phase 2A-2 defaults to local filesystem; Phase 2A-3 adds s3/MinIO)
STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=apps/web/public/images

# Redis Queue / Rate-Limit Backend (Phase 2A-3+)
REDIS_URL=redis://localhost:6379

# Optional Object Storage (Cloudflare R2 / MinIO S3 — Phase 2A-3+)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=fpt-virtual-campus-media
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_PUBLIC_DOMAIN=https://media.example.invalid
