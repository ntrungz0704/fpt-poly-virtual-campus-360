// ============================================================================
// FPT Polytechnic Virtual Campus 360° (QTSC District 12)
// Phase 2A-1 — Canonical PostgreSQL 16 + Prisma 6 Schema
// Synchronized with docs/phase-2a/PHASE_2A_DATABASE_DESIGN.md (v2A.2, OD-01 -> OD-10)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums (Section 4 of PHASE_2A_DATABASE_DESIGN.md)
// ============================================================================

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum FloorPlanFormat {
  PNG
  JPG
  SVG
  PDF
}

enum MediaKind {
  PANORAMA_2_1
  PHOTO_2D
  THUMBNAIL
}

enum BuildingCategory {
  ACADEMIC
  LAB
  FACILITY
}

enum MapBuildingIconKey {
  INNOVATION
  IT_BUILDING
  DESIGN_STUDIO
  ACADEMIC_HALL
  SPORTS
}

enum TourEdgeType {
  WALKWAY
  DOORWAY
  STAIRS
  ELEVATOR
  OUTDOOR_LINK
}

enum AlignmentStatus {
  PENDING_REVIEW
  CONFIRMED
}

enum HotspotType {
  SCENE_LINK
  INFO
  QUIZ_TRIGGER
}

enum UserType {
  ADMIN
  STAFF
  STUDENT
  PARENT
}

enum AccountStatus {
  ACTIVE
  LOCKED
  SUSPENDED
  ARCHIVED
}

enum ActivationStatus {
  PENDING_ACTIVATION
  INVITATION_SENT
  ACTIVATED
  EXPIRED
  REVOKED
}

enum ProvisioningMethod {
  BOOTSTRAP
  ADMIN_DIRECT
  EMAIL_SMS_INVITATION
}

enum InvitationChannel {
  DIRECT_LINK
  EMAIL
  SMS
}

enum InvitationStatus {
  INVITATION_PENDING
  SENT
  EXPIRED
  ACTIVATED
  FAILED
}

enum SessionPeriod {
  MORNING
  NOON
  AFTERNOON
}

enum ParticipationStatus {
  INVITED
  CONFIRMED
  CANCELLED
}

// ============================================================================
// 3.1 Campus & FloorPlan Domain
// ============================================================================

model Campus {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String        @db.VarChar(32)
  name               String        @db.VarChar(160)
  address            String        @db.Text
  originPointJson    Json          @map("origin_point_json") @db.JsonB
  landmarksJson      Json          @default("[]") @map("landmarks_json") @db.JsonB
  defaultEntryNodeId String?       @map("default_entry_node_id") @db.Uuid
  status             PublishStatus @default(PUBLISHED)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)

  defaultEntryNode TourNode?        @relation("CampusDefaultEntryNode", fields: [defaultEntryNodeId], references: [id], onDelete: SetNull)
  buildings        Building[]
  openDayEvents    OpenDayEvent[]
  openDaySessions  OpenDaySession[]
  openDayFaqs      OpenDayFaq[]

  @@map("campuses")
}

model Building {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campusId           String             @map("campus_id") @db.Uuid
  code               String             @db.VarChar(32)
  slug               String             @db.VarChar(100)
  name               String             @db.VarChar(160)
  shortName          String             @map("short_name") @db.VarChar(80)
  category           BuildingCategory
  categoryLabel      String             @map("category_label") @db.VarChar(80)
  floorsLabel        String             @map("floors_label") @db.VarChar(80)
  summary            String             @db.VarChar(280)
  description        String             @db.Text
  highlightsJson     Json               @default("[]") @map("highlights_json") @db.JsonB
  lat                Float              @db.DoublePrecision
  lng                Float              @db.DoublePrecision
  addressNote        String             @map("address_note") @db.Text
  statusNote         String             @map("status_note") @db.VarChar(160)
  mapIconKey         MapBuildingIconKey @map("map_icon_key")
  routeWaypointsJson Json               @default("[]") @map("route_waypoints_json") @db.JsonB
  gisX               Float?             @map("gis_x") @db.DoublePrecision
  gisY               Float?             @map("gis_y") @db.DoublePrecision
  coverMediaId       String?            @map("cover_media_id") @db.Uuid
  defaultNodeId      String?            @map("default_node_id") @db.Uuid
  sortOrder          Int                @default(0) @map("sort_order")
  status             PublishStatus      @default(DRAFT)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)

  campus          Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  coverMedia      MediaAsset?      @relation("BuildingCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  defaultNode     TourNode?        @relation("BuildingDefaultNode", fields: [defaultNodeId], references: [id], onDelete: SetNull)
  floors          Floor[]
  locations       Location[]
  openDaySessions OpenDaySession[]

  @@map("buildings")
}

model Floor {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId        String        @map("building_id") @db.Uuid
  code              String        @db.VarChar(24)
  name              String        @db.VarChar(100)
  levelIndex        Int           @map("level_index")
  activeFloorPlanId String?       @map("active_floor_plan_id") @db.Uuid
  requiresFloorPlan Boolean       @default(false) @map("requires_floor_plan")
  status            PublishStatus @default(DRAFT)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  building        Building    @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  activeFloorPlan FloorPlan?  @relation("ActiveFloorPlan", fields: [activeFloorPlanId], references: [id], onDelete: SetNull)
  floorPlans      FloorPlan[] @relation("FloorVersions")
  locations       Location[]

  @@map("floors")
}

model FloorPlan {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  floorId            String           @map("floor_id") @db.Uuid
  version            Int              @default(1)
  sourceFormat       FloorPlanFormat  @map("source_format")
  sourceObjectKey    String           @map("source_object_key") @db.Text
  renderObjectKey    String?          @map("render_object_key") @db.Text
  thumbnailObjectKey String?          @map("thumbnail_object_key") @db.Text
  sourcePageNumber   Int              @default(1) @map("source_page_number")
  renderWidth        Int?             @map("render_width")
  renderHeight       Int?             @map("render_height")
  aspectRatio        Float?           @map("aspect_ratio") @db.DoublePrecision
  northOffsetDeg     Float            @default(0) @map("north_offset_deg") @db.DoublePrecision
  processingStatus   ProcessingStatus @default(PENDING) @map("processing_status")
  processingError    String?          @map("processing_error") @db.Text
  uploadedBy         String           @map("uploaded_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  floor             Floor                        @relation("FloorVersions", fields: [floorId], references: [id], onDelete: Restrict)
  uploader          User                         @relation("FloorPlanUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  activeForFloors   Floor[]                      @relation("ActiveFloorPlan")
  tourNodes         TourNode[]
  newSnapshots      FloorPlanAlignmentSnapshot[] @relation("SnapshotNewFloorPlan")
  previousSnapshots FloorPlanAlignmentSnapshot[] @relation("SnapshotPreviousFloorPlan")

  @@unique([floorId, version])
  @@map("floor_plans")
}

model FloorPlanAlignmentSnapshot {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newFloorPlanId      String          @map("new_floor_plan_id") @db.Uuid
  previousFloorPlanId String?         @map("previous_floor_plan_id") @db.Uuid
  nodeCoordsSnapshot  Json            @map("node_coords_snapshot") @db.JsonB
  alignmentStatus     AlignmentStatus @default(PENDING_REVIEW) @map("alignment_status")
  confirmedBy         String?         @map("confirmed_by") @db.Uuid
  confirmedAt         DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  newFloorPlan      FloorPlan  @relation("SnapshotNewFloorPlan", fields: [newFloorPlanId], references: [id], onDelete: Restrict)
  previousFloorPlan FloorPlan? @relation("SnapshotPreviousFloorPlan", fields: [previousFloorPlanId], references: [id], onDelete: SetNull)
  confirmer         User?      @relation("AlignmentConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@map("floor_plan_alignment_snapshots")
}

// ============================================================================
// 3.2 Location & Media Pipeline Domain
// ============================================================================

model LocationType {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String  @unique @db.VarChar(40)
  filterGroup           String  @map("filter_group") @db.VarChar(24)
  label                 String  @db.VarChar(100)
  iconName              String  @map("icon_name") @db.VarChar(60)
  isInterFloorConnector Boolean @default(false) @map("is_inter_floor_connector")

  locations Location[]

  @@map("location_types")
}

model Location {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId         String        @map("building_id") @db.Uuid
  floorId            String?       @map("floor_id") @db.Uuid
  locationTypeId     String        @map("location_type_id") @db.Uuid
  categoryLabel      String        @map("category_label") @db.VarChar(80)
  code               String        @db.VarChar(48)
  slug               String        @db.VarChar(120)
  name               String        @db.VarChar(160)
  shortSummary       String        @map("short_summary") @db.VarChar(280)
  description        String        @db.Text
  highlightsJson     Json          @default("[]") @map("highlights_json") @db.JsonB
  floorNormX         Float?        @map("floor_norm_x") @db.DoublePrecision
  floorNormY         Float?        @map("floor_norm_y") @db.DoublePrecision
  floorPolygonNorm   Json?         @map("floor_polygon_norm") @db.JsonB
  isPublicAccessible Boolean       @default(true) @map("is_public_accessible")
  restrictionNote    String?       @map("restriction_note") @db.Text
  primaryNodeId      String?       @map("primary_node_id") @db.Uuid
  status             PublishStatus @default(DRAFT)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)

  building        Building         @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  floor           Floor?           @relation(fields: [floorId], references: [id], onDelete: Restrict)
  locationType    LocationType     @relation(fields: [locationTypeId], references: [id], onDelete: Restrict)
  primaryNode     TourNode?        @relation("LocationPrimaryNode", fields: [primaryNodeId], references: [id], onDelete: SetNull)
  tourNodes       TourNode[]       @relation("LocationTourNodes")
  locationMedia   LocationMedia[]
  openDaySessions OpenDaySession[]

  @@map("locations")
}

model MediaAsset {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetKind           MediaKind        @map("asset_kind")
  originalFilename    String           @map("original_filename") @db.VarChar(255)
  mimeType            String           @map("mime_type") @db.VarChar(100)
  fileSizeBytes       BigInt           @map("file_size_bytes") @db.BigInt
  sha256Checksum      String           @map("sha256_checksum") @db.Char(64)
  originalWidth       Int              @map("original_width")
  originalHeight      Int              @map("original_height")
  isValid2To1         Boolean          @default(false) @map("is_valid_2_to_1")
  isPreviewApproved   Boolean          @default(false) @map("is_preview_approved")
  originalObjectKey   String           @map("original_object_key") @db.Text
  optimizedDesktopKey String?          @map("optimized_desktop_key") @db.Text
  optimizedMobileKey  String?          @map("optimized_mobile_key") @db.Text
  thumbnailKey        String?          @map("thumbnail_key") @db.Text
  cameraMetadata      Json?            @map("camera_metadata") @db.JsonB
  processingStatus    ProcessingStatus @default(PENDING) @map("processing_status")
  processingError     String?          @map("processing_error") @db.Text
  uploadedBy          String           @map("uploaded_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)

  uploader          User            @relation("MediaAssetUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  coverForBuildings Building[]      @relation("BuildingCoverMedia")
  panoramaTourNodes TourNode[]      @relation("TourNodePanoramaAsset")
  locationMedia     LocationMedia[]

  @@index([sha256Checksum], map: "idx_media_sha256")
  @@map("media_assets")
}

model LocationMedia {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId   String  @map("location_id") @db.Uuid
  mediaAssetId String  @map("media_asset_id") @db.Uuid
  isCover      Boolean @default(false) @map("is_cover")
  sortOrder    Int     @default(0) @map("sort_order")
  caption      String? @db.VarChar(200)

  location   Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([locationId, mediaAssetId])
  @@map("location_media")
}

// ============================================================================
// 3.3 Tour Nodes, Edges & Hotspots Domain
// ============================================================================

model TourNode {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String        @db.VarChar(100)
  title                  String        @db.VarChar(160)
  intro                  String        @db.Text
  category               String        @default("study") @db.VarChar(24)
  locationId             String        @map("location_id") @db.Uuid
  floorPlanId            String?       @map("floor_plan_id") @db.Uuid
  panoramaAssetId        String        @map("panorama_asset_id") @db.Uuid
  floorNormX             Float?        @map("floor_norm_x") @db.DoublePrecision
  floorNormY             Float?        @map("floor_norm_y") @db.DoublePrecision
  needsRealignment       Boolean       @default(false) @map("needs_realignment")
  headingOffsetDeg       Float         @default(0) @map("heading_offset_deg") @db.DoublePrecision
  initialYaw             Float         @default(0) @map("initial_yaw") @db.DoublePrecision
  initialPitch           Float         @default(0) @map("initial_pitch") @db.DoublePrecision
  initialFov             Float         @default(75) @map("initial_fov") @db.DoublePrecision
  isTerminalApproved     Boolean       @default(false) @map("is_terminal_approved")
  terminalApprovalReason String?       @map("terminal_approval_reason") @db.VarChar(240)
  sortOrder              Int           @default(0) @map("sort_order")
  status                 PublishStatus @default(DRAFT)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(6)

  location          Location          @relation("LocationTourNodes", fields: [locationId], references: [id], onDelete: Restrict)
  floorPlan         FloorPlan?        @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)
  panoramaAsset     MediaAsset        @relation("TourNodePanoramaAsset", fields: [panoramaAssetId], references: [id], onDelete: Restrict)
  defaultForCampus  Campus[]          @relation("CampusDefaultEntryNode")
  defaultForBldgs   Building[]        @relation("BuildingDefaultNode")
  primaryForLocs    Location[]        @relation("LocationPrimaryNode")
  outgoingEdges     TourEdge[]        @relation("EdgeFromNode")
  incomingEdges     TourEdge[]        @relation("EdgeToNode")
  hotspots          Hotspot[]         @relation("NodeHotspots")
  openDaySessions   OpenDaySession[]
  openDayQuizItems  OpenDayQuizItem[]

  @@map("tour_nodes")
}

model TourEdge {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromNodeId           String       @map("from_node_id") @db.Uuid
  toNodeId             String       @map("to_node_id") @db.Uuid
  edgeType             TourEdgeType @default(WALKWAY) @map("edge_type")
  label                String       @db.VarChar(120)
  targetEntryYaw       Float?       @map("target_entry_yaw") @db.DoublePrecision
  targetEntryPitch     Float?       @map("target_entry_pitch") @db.DoublePrecision
  isOneWayApproved     Boolean      @default(false) @map("is_one_way_approved")
  oneWayApprovalReason String?      @map("one_way_approval_reason") @db.VarChar(240)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  fromNode TourNode @relation("EdgeFromNode", fields: [fromNodeId], references: [id], onDelete: Restrict)
  toNode   TourNode @relation("EdgeToNode", fields: [toNodeId], references: [id], onDelete: Restrict)
  hotspot  Hotspot? @relation("EdgeHotspot")

  @@unique([fromNodeId, toNodeId, edgeType])
  @@map("tour_edges")
}

model Hotspot {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId      String      @map("node_id") @db.Uuid
  hotspotType HotspotType @map("hotspot_type")
  edgeId      String?     @unique @map("edge_id") @db.Uuid
  yaw         Float       @db.DoublePrecision
  pitch       Float       @db.DoublePrecision
  title       String      @db.VarChar(140)
  body        String?     @db.Text
  payloadJson Json?       @map("payload_json") @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  node TourNode  @relation("NodeHotspots", fields: [nodeId], references: [id], onDelete: Restrict)
  edge TourEdge? @relation("EdgeHotspot", fields: [edgeId], references: [id], onDelete: Cascade)

  @@map("hotspots")
}

// ============================================================================
// 3.4 Auth, RBAC, Provisioning & Compliance Domain
// ============================================================================

model User {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username            String?            @db.VarChar(64)
  fullName            String             @map("full_name") @db.VarChar(160)
  email               String?            @db.VarChar(160)
  phone               String?            @db.VarChar(32)
  userType            UserType           @map("user_type")
  accountStatus       AccountStatus      @default(ACTIVE) @map("account_status")
  activationStatus    ActivationStatus   @default(PENDING_ACTIVATION) @map("activation_status")
  provisioningMethod  ProvisioningMethod @map("provisioning_method")
  passwordHash        String?            @map("password_hash") @db.Text
  mustChangePassword  Boolean            @default(false) @map("must_change_password")
  failedLoginAttempts Int                @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?          @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?          @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)

  userRoles               UserRole[]
  uploadedFloorPlans      FloorPlan[]                  @relation("FloorPlanUploader")
  confirmedAlignments     FloorPlanAlignmentSnapshot[] @relation("AlignmentConfirmer")
  uploadedMediaAssets     MediaAsset[]                 @relation("MediaAssetUploader")
  invitationsReceived     AccountInvitation[]          @relation("InvitationRecipient")
  invitationsCreated      AccountInvitation[]          @relation("InvitationCreator")
  eventParticipations     EventParticipation[]         @relation("ParticipantUser")
  provisionedParticipants EventParticipation[]         @relation("ParticipationProvisioner")
  importBatches           UserImportBatch[]            @relation("BatchImporter")
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]

  @@map("users")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(48)
  name        String  @db.VarChar(100)
  description String? @db.Text

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(80)
  description String? @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AccountInvitation {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  channel       InvitationChannel
  tokenHash     String            @unique @map("token_hash") @db.Char(64)
  status        InvitationStatus
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  sentAt        DateTime?         @map("sent_at") @db.Timestamptz(6)
  activatedAt   DateTime?         @map("activated_at") @db.Timestamptz(6)
  resendCount   Int               @default(0) @map("resend_count")
  failureReason String?           @map("failure_reason") @db.Text
  createdBy     String            @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User @relation("InvitationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  creator User @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("account_invitations")
}

model EventParticipation {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  eventId             String              @map("event_id") @db.Uuid
  participationStatus ParticipationStatus @default(INVITED) @map("participation_status")
  provisionedBy       String?             @map("provisioned_by") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation("ParticipantUser", fields: [userId], references: [id], onDelete: Restrict)
  event       OpenDayEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  provisioner User?        @relation("ParticipationProvisioner", fields: [provisionedBy], references: [id], onDelete: SetNull)

  @@unique([userId, eventId])
  @@map("event_participations")
}

model UserImportBatch {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importedBy            String             @map("imported_by") @db.Uuid
  defaultUserType       UserType           @map("default_user_type")
  provisioningMethod    ProvisioningMethod @map("provisioning_method")
  totalRows             Int                @map("total_rows")
  successCount          Int                @map("success_count")
  skippedCount          Int                @map("skipped_count")
  failedCount           Int                @map("failed_count")
  rowResultsSummaryJson Json               @map("row_results_summary_json") @db.JsonB
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  importer User @relation("BatchImporter", fields: [importedBy], references: [id], onDelete: Restrict)

  @@map("user_import_batches")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.Text
  ipAddress String?   @map("ip_address") @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorUsername String?  @map("actor_username") @db.VarChar(64)
  action        String   @db.VarChar(80)
  resourceType  String?  @map("resource_type") @db.VarChar(64)
  resourceId    String?  @map("resource_id") @db.Uuid
  diffJson      Json?    @map("diff_json") @db.JsonB
  ipAddress     String?  @map("ip_address") @db.Inet
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ============================================================================
// 3.5 Open Day Domain (OD-03 Option B, OD-08)
// ============================================================================

model OpenDayEvent {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campusId  String        @map("campus_id") @db.Uuid
  eventKey  String        @map("event_key") @db.VarChar(80)
  title     String        @db.VarChar(160)
  subtitle  String?       @db.Text
  dateLabel String        @map("date_label") @db.VarChar(80)
  timeLabel String        @map("time_label") @db.VarChar(80)
  eventDate DateTime?     @map("event_date") @db.Date
  isDefault Boolean       @default(false) @map("is_default")
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)

  campus         Campus               @relation(fields: [campusId], references: [id], onDelete: Restrict)
  sessions       OpenDaySession[]
  faqs           OpenDayFaq[]
  participations EventParticipation[]

  @@map("open_day_events")
}

model OpenDaySession {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String        @map("event_id") @db.Uuid
  campusId            String        @map("campus_id") @db.Uuid
  buildingId          String?       @map("building_id") @db.Uuid
  locationId          String?       @map("location_id") @db.Uuid
  tourNodeId          String?       @map("tour_node_id") @db.Uuid
  title               String        @db.VarChar(160)
  sessionPeriod       SessionPeriod @map("session_period")
  startTimeLabel      String        @map("start_time_label") @db.VarChar(24)
  endTimeLabel        String        @map("end_time_label") @db.VarChar(24)
  timeRangeLabel      String        @map("time_range_label") @db.VarChar(48)
  customLocationLabel String        @map("custom_location_label") @db.VarChar(160)
  hostUnit            String        @map("host_unit") @db.VarChar(120)
  isPublic            Boolean       @default(true) @map("is_public")
  description         String        @db.Text
  sortOrder           Int           @default(0) @map("sort_order")
  status              PublishStatus @default(DRAFT)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)

  event    OpenDayEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  campus   Campus       @relation(fields: [campusId], references: [id], onDelete: Restrict)
  building Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tourNode TourNode?    @relation(fields: [tourNodeId], references: [id], onDelete: SetNull)

  @@map("open_day_sessions")
}

model OpenDayFaq {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String?       @map("event_id") @db.Uuid
  campusId  String        @map("campus_id") @db.Uuid
  question  String        @db.VarChar(280)
  answer    String        @db.Text
  sortOrder Int           @default(0) @map("sort_order")
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)

  event  OpenDayEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  campus Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@map("open_day_faqs")
}

model OpenDayQuizItem {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tourNodeId   String?       @map("tour_node_id") @db.Uuid
  questionText String        @map("question_text") @db.VarChar(280)
  optionsJson  Json          @map("options_json") @db.JsonB
  correctIndex Int           @map("correct_index")
  explanation  String        @db.Text
  sortOrder    Int           @default(0) @map("sort_order")
  status       PublishStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)

  tourNode TourNode? @relation(fields: [tourNodeId], references: [id], onDelete: SetNull)

  @@map("open_day_quiz_items")
}
